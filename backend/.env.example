# MongoDB connection. Use a full connection string (e.g. mongodb+srv://... for
# Atlas). Required in production (there is no localhost fallback there). MONGODB_DB_NAME is applied via Mongoose's `dbName` option so it works
# whether or not the URI already includes a database path segment.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=homenest

# HTTP server port.
PORT=4000

# Number of reverse proxies (load balancer, ingress, CDN) in front of this
# server. Express uses it to read the real client IP from X-Forwarded-For, which
# the login and contact rate limiters key on. Leave at 0 when clients connect
# directly; set to the exact hop count behind a proxy (usually 1). Never "true".
# Required in production (the server refuses to start without it). Behind a
# proxy such as Render or Railway, set it to 1.
TRUST_PROXY_HOPS=0

# Exact frontend origin(s) allowed to call this API with credentials: one, or a
# comma-separated list (scheme + host [+ port], no path). Spaces and trailing
# slashes are trimmed. "*" is rejected. Required in production, for example
# CORS_ORIGIN=https://www.example.com,https://example.com
CORS_ORIGIN=http://localhost:3000

# SameSite policy for the HTTP-only auth cookie (lax, strict, or none).
COOKIE_SAMESITE=strict

# Frontend base URL. Verification emails link to <APP_URL>/verify-email.
# Required in production.
APP_URL=http://localhost:3000

# SMTP settings for verification emails. With SMTP_HOST empty (local
# development) the link is printed to the server console instead of emailed.
# SMTP_HOST and MAIL_FROM are required in production (e.g. smtp.example.com).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM="HomeNest <no-reply@example.com>"

# Optional internal recipient for "new loan enquiry" alerts (reference ID and
# loan type only, no applicant details). Leave empty to send no alerts. Needs
# SMTP_HOST set to actually deliver; a delivery failure never affects the
# saved enquiry.
LOAN_ENQUIRY_NOTIFY_EMAIL=

# Secret used to sign JWTs issued by /api/auth. Required in production - the
# server refuses to start without it. Generate a long random value (e.g.
# `openssl rand -hex 64`); never commit the real value. In production it must be
# at least 32 characters and must not look like a placeholder.
JWT_SECRET=replace-with-output-of-openssl-rand-hex-64

# Cloudinary upload configuration for direct browser uploads via signed upload
# parameters. Fill these from your Cloudinary dashboard. All three are required
# in production.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=property-images

# Shared secret the scraper sends in the x-api-key header when calling
# POST /api/v1/admin/import/properties. If unset, that endpoint rejects every
# request. Generate a long random value (e.g. `openssl rand -hex 32`).
IMPORT_API_KEY=replace-with-output-of-openssl-rand-hex-32

# Database used by `npm test`. Tests create and DROP whole databases, so they
# never use MONGODB_URI above. Defaults to a local mongod; start one first (see
# README, "Running the tests"). The run refuses to start if this points at an
# Atlas host or at the same URI as MONGODB_URI, and any database it connects to
# must have "test" in its name (every test file uses homenest_test_*).
# MONGODB_URI_TEST=mongodb://127.0.0.1:27017

# Optional: AI provider for the Property Finder assistant (POST /api/v1/assistant/chat).
# Leave ANTHROPIC_API_KEY empty to run without AI: the assistant then uses its
# built-in rule-based understanding and everything still works. When set, the
# Anthropic Messages API is used ONLY to read what the visitor typed into
# preferences (budget, city, BHK, ...). Its output is validated server-side and
# it never writes replies, builds queries or sees contact details. Get a key from
# the Anthropic Console; keep it server-side only, never in a NEXT_PUBLIC_ variable.
ANTHROPIC_API_KEY=
# Model used for that extraction (a small, fast model is enough).
ASSISTANT_AI_MODEL=claude-haiku-5-5
# Give up on the provider after this many ms and fall back to the rules.
ASSISTANT_AI_TIMEOUT_MS=8000
