# Copy to .env.local for local development.

# Base URL of the HomeNest backend API. NEXT_PUBLIC_* values are inlined at
# build time: set this before `npm run build` and rebuild after changing it.
# Must be the public https URL of the deployed API in production (no trailing
# slash needed), or the built site will call http://localhost:4000.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public origin of this site, used for canonical URLs, Open Graph tags,
# robots.txt and the sitemap. Required for any deployed build (for example
# https://www.homenest.in). Falls back to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 measurement ID (for example G-XXXXXXXXXX). Empty means analytics is off.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
